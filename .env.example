# Copy to .env in the repository root. Never commit the filled .env.
# Generate a local key; do not copy it into logs or reports.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Backend runs on Windows; PostgreSQL runs in Docker Compose.
POSTGRES_DB=qa_interview_lab
POSTGRES_TEST_DB=test_qa_interview_lab
POSTGRES_USER=qil
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
